{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@aiai/providers": [
        "../../packages/providers/src"
      ],
      "@aiai/prompt-engine": [
        "../../packages/prompt-engine/src"
      ],
      "@aiai/skill-engine": [
        "../../packages/skill-engine/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
